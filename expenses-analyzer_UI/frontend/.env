# ============================================================
# frontend/.env
#
# Vite environment variables for local development.
#
# IMPORTANT:
#   - Variables MUST start with VITE_ to be exposed to the browser.
#   - Do NOT put passwords, database credentials, or SQL Server
#     connection strings here. The frontend never connects to the DB.
#   - This file should NOT be committed to Git (add to .gitignore).
#
# Usage in TypeScript:
#   const API_BASE_URL = import.meta.env.VITE_API_BASE_URL;
# ============================================================

VITE_API_BASE_URL=http://127.0.0.1:8000
