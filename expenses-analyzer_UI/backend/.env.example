# =============================================================
# .env.example
#
# Template for environment variables.
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.
# =============================================================

# SQL Server — Windows Authentication (no username/password)
DATABASE_URL=mssql+pyodbc://localhost\SQLEXPRESS/ExpenseAnalyzerDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=no

# Alternative: SQL Server Login (username + password)
# DATABASE_URL=mssql+pyodbc://username:password@localhost\SQLEXPRESS/ExpenseAnalyzerDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=no

# Application
APP_ENV=development
APP_PORT=8000

# CORS — React frontend URL (local development)
FRONTEND_URL=http://localhost:5173
